<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/black"
    android:orientation="vertical"
    tools:context=".Login">

    <TextView
        android:id="@+id/textView4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:maxLines="1"
        android:text="@string/txt1.1"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp">

        <TextView
            android:layout_width="109dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="50dp"
            android:text="@string/txt1.2"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtHOSV"
            android:layout_width="219dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp">

        <TextView
            android:layout_width="109dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:text="@string/txt1.3"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtTENSV"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp">

        <TextView
            android:layout_width="109dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:text="@string/txt1.4"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtLOP"
            android:layout_width="221dp"
            android:layout_height="48dp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="347dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp">

        <TextView
            android:layout_width="109dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:text="@string/txt1.5"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtMSSV"
            android:layout_width="222dp"
            android:layout_height="48dp"
            android:layout_marginTop="3dp" />

    </LinearLayout>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            style="@style/Widget.AppCompat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/black"
            android:text="@string/txtHT"
            android:textColor="@color/white" />

        <Button
            style="@style/Widget.AppCompat.Button"
            android:layout_width="83dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/black"
            android:text="@string/txtTHEM"
            android:textColor="@color/white" />

        <Button
            style="@style/Widget.AppCompat.Button"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/black"
            android:text="@string/txtSUA"
            android:textColor="@color/white" />

        <Button
            style="@style/Widget.AppCompat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/black"
            android:text="@string/txtXOA"
            android:textColor="@color/white" />



    </LinearLayout>

</LinearLayout>
