<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ĐồÁn1" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/dashboard_panel_color</item>
        <item name="colorPrimaryDark">@color/dashboard_backdrop</item>
        <item name="colorAccent">@color/dashboard_accent</item>
        <item name="colorControlNormal">@color/dashboard_secondary_text</item>
        <item name="android:windowBackground">@color/dashboard_backdrop</item>
        <item name="alertDialogTheme">@style/Hssv.Dialog</item>
    </style>

    <style name="Hssv.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/dashboard_accent</item>
        <item name="colorControlNormal">@color/dashboard_secondary_text</item>
        <item name="android:windowBackground">@drawable/dashboard_panel</item>
    </style>

    <style name="Hssv.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/dashboard_tile_background</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
